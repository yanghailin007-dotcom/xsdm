# 忽略大文件（构建产物，手动上传到服务器）
NovelPublisher.exe
*.exe
NovelPublisher-macos.zip
NovelPublisher-macos-*.zip

# PyInstaller 构建文件
build/
dist/

# 忽略生成的 spec 文件，但保留我们手动维护的 spec 文件
!NovelPublisher.spec
!NovelPublisher_onefile.spec

# 浏览器数据
browser_data/
accounts/

# 配置文件（包含敏感信息）
config.json
accounts.json
.dev_mode

# Git filter-branch 临时文件
.git-rewrite/
