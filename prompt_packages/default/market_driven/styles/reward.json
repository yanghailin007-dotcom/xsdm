{
  "style_id": "reward",
  "style_name": "收获流写法",
  "version": "1.0.0",
  "description": "展示成果，获得好处，让读者有获得感和满足感",
  
  "core_principles": [
    "具体数字：精确的金额/数值/属性，让读者有实感",
    "效果展示：不仅获得，还要展示使用效果和威力",
    "前后对比：获得前后的对比，强化获得感",
    "他人反应：周围人的羡慕/震惊，增强爽感",
    "新目标：收获后立刻建立新目标，保持期待"
  ],
  
  "structure": {
    "name": "收获章结构",
    "total_words": "2400-2500字",
    "phases": [
      {
        "name": "期待",
        "word_count": "0-500字",
        "intensity": 7,
        "description": "获得前铺垫",
        "requirements": ["即将获得的期待", "风险/代价铺垫", "悬念建立"]
      },
      {
        "name": "惊喜",
        "word_count": "501-1200字",
        "intensity": 8,
        "description": "获得过程",
        "requirements": ["系统提示音", "获得过程描写", "具体数字展示"]
      },
      {
        "name": "满足",
        "word_count": "1201-2000字",
        "intensity": 9,
        "description": "效果展示",
        "requirements": ["能力/物品效果展示", "具体应用场景", "周围人反应"]
      },
      {
        "name": "应用",
        "word_count": "2001-2400字",
        "intensity": 8,
        "description": "实际使用",
        "requirements": ["实际使用场景", "效果验证", "前后对比"]
      },
      {
        "name": "期待",
        "word_count": "2401-2500字",
        "intensity": 7,
        "description": "新目标",
        "requirements": ["新目标确立", "更大期待", "章尾钩子"]
      }
    ]
  },
  
  "required_elements": [
    "系统提示音：【叮！恭喜宿主XXX！】",
    "具体收益：精确的数值/物品/能力",
    "效果展示：让读者有获得感",
    "实际应用：展示如何使用",
    "对比：之前vs现在"
  ],
  
  "genre_specific": {
    "神豪文": {
      "elements": ["具体金额", "返利到账音效", "消费场景展示"],
      "examples": ["【叮！返利到账1000万！】", "银行卡余额：999,999,999"]
    },
    "国运文": {
      "elements": ["国运值变化", "全球排名", "国家奖励"],
      "examples": ["【龙国国运值+5%！全球排名第3！】", "天降祥瑞，龙气升腾"]
    },
    "模拟器": {
      "elements": ["天赋效果", "属性提升", "模拟过程展示"],
      "examples": ["【获得金色天赋：悟性逆天】", "悟性：80→95"]
    },
    "修仙": {
      "elements": ["境界突破", "战力数值", "天地异象"],
      "examples": ["【突破！筑基期→金丹期！】", "雷劫降临，金丹大成"]
    }
  },
  
  "system_prompts": [
    "【叮！恭喜宿主获得XXX！】",
    "【奖励发放中...】",
    "【恭喜！您已完成XXX成就！】",
    "【警告！检测到SSS级奖励！】"
  ],
  
  "forbidden": [
    "没有具体数字的虚写",
    "获得后不展示效果",
    "平淡的获得过程（必须有波折/期待）",
    "获得后没有新目标（收获即终点）",
    "周围人没有反应（独自获得）"
  ],
  
  "checklist": [
    "是否有具体数字？",
    "系统提示音是否清晰？",
    "效果是否展示充分？",
    "是否有前后对比？",
    "周围人是否有反应？",
    "获得后是否有新目标？"
  ]
}
