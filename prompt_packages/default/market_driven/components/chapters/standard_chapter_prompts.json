{
  "version": "1.0.0",
  "description": "标准章节提示词模板配置（第4章以后）",
  
  "standard_chapter": {
    "name": "标准章节",
    "type": "STANDARD",
    "word_count": {
      "target": "2200-2500字",
      "minimum": 2000,
      "allocation": {
        "opening_hook": "200-300字",
        "development": "600-800字",
        "climax": "800-1000字",
        "reaction": "300-400字",
        "ending_hook": "100-150字"
      }
    },
    
    "algorithm_requirements": {
      "emotion_density": {
        "target": "≥2.0个/千字",
        "min_per_500_words": 1,
        "min_total": 10,
        "vocabulary": {
          "anger": ["暴怒", "狂怒", "目眦欲裂", "杀意滔天", "怒火中烧"],
          "shock": ["震撼", "骇然", "惊恐", "目瞪口呆", "头皮发麻", "倒吸凉气"],
          "satisfaction": ["狂喜", "激动", "兴奋", "畅快", "扬眉吐气", "通体舒泰"],
          "oppression": ["绝望", "无力", "屈辱", "悲愤", "心如刀割"],
          "twist": ["错愕", "懵然", "难以置信", "惊骇欲绝"]
        }
      },
      "hook_presence": {
        "target": "100%",
        "last_50_words": "必须是悬念/钩子",
        "types": ["时间锁", "信息差", "危机", "身份揭露", "反派出招"]
      },
      "appeal_density": {
        "target": "≥1.5个/千字",
        "min_per_1000_words": 1,
        "vocabulary": {
          "crush": ["碾压", "横扫", "瞬杀", "一招秒杀", "摧枯拉朽"],
          "shock": ["全场死寂", "骇然失色", "难以置信", "怀疑人生"],
          "gain": ["暴涨", "飙升", "翻倍", "突破", "觉醒"],
          "faceslap": ["打脸", "反转", "跪服", "求饶", "后悔莫及"]
        }
      },
      "basic": [
        "前300字必须出现冲突/悬念",
        "每1000字必须有一个小爽点",
        "章尾最后50字必须是钩子",
        "对话占比≥50%",
        "每段不超过3行"
      ]
    },
    
    "expansion_strategies": [
      "增加弹幕三层反应（现场→直播→全网）",
      "增加震惊层级（围观者→强者→官方）",
      "增加数字可视化（国运值变化的具体表现）",
      "增加配角反应链（从质疑到震惊到跪服）"
    ],
    
    "forbidden_expansion": [
      "无意义的环境描写",
      "冗长的心理独白",
      "重复的对话"
    ],
    
    "coherence_check": [
      "上一章的对手/反派是否已明确结局（击败/死亡/撤退）？",
      "本章新出场的角色是否有合理的引入铺垫（预警/通讯/气息）？",
      "上一章的系统提示/伏笔是否被处理或延续？",
      "主角当前状态（伤势/能力/位置）是否与上一章一致？"
    ],
    
    "output_format": {
      "title": {
        "length": "8-14字",
        "exclude_chapter_number": true,
        "content": "概括本章核心爽点/悬念",
        "style": "简洁有力，有冲击力"
      },
      "schema": {
        "title": "string",
        "content": "string"
      },
      "rules": [
        "title字段只放标题文本，不要加'第X章'前缀",
        "content字段只放正文，绝对禁止在正文开头写'第X章 XXX'",
        "chapter_number字段绝对禁止出现！",
        "禁止在正文中包含 `---正文结束---` 等分隔符！"
      ]
    },
    
    "self_check_steps": [
      {
        "name": "字数检查",
        "items": [
          "计算字数（不含标题和标记）：____字",
          "如果 < 2000字：必须扩写，禁止提交",
          "如果 2000-2200字：建议扩写到2200以上",
          "如果 ≥ 2200字：通过"
        ]
      },
      {
        "name": "基础指标",
        "items": [
          "对话占比：≥50%？",
          "每段：1-3行？",
          "视角：第三人称上帝视角？"
        ]
      },
      {
        "name": "番茄算法",
        "items": [
          "前300字：冲突/悬念？",
          "每1000字：小爽点？",
          "最后50字：必须是钩子！"
        ]
      },
      {
        "name": "情绪密度",
        "items": [
          "统计情绪词数量：X个（目标≥10个，≥2.0/千字）",
          "情绪转变：≥3次？",
          "高潮部分（后1/3）：强度8-10/10？",
          "是否用了强烈情绪词（暴怒/骇然/狂喜）？"
        ]
      },
      {
        "name": "爽点密度",
        "items": [
          "爽点类型：装逼/收获/打脸/震惊？",
          "爽点时刻数量：X个（目标≥3个）",
          "爽点密度：X个/千字（目标≥1.5）",
          "爽点是否有震惊反应链？"
        ]
      },
      {
        "name": "章尾钩子",
        "items": [
          "最后50字必须是钩子！",
          "钩子类型：时间锁/信息差/危机/身份揭露？",
          "是否让人想点下一章？"
        ]
      }
    ],
    
    "report_template": "【AI自检报告 - 第{chapter_num}章】\n总字数：XXXX字\n\n🚨【三大问题修复检查】\n情绪密度：X个/千字（目标≥2.0）| 情绪词：XXX、XXX、XXX...\n章尾钩子：有/无 | 钩子类型：XXX | 最后50字：\"...\"\n爽点密度：X个/千字（目标≥1.5）| 爽点时刻：X个\n\n番茄算法：前300字冲突（是/否），每1000字爽点（是/否）\n情绪曲线：X次转变，高潮强度（X/10）\n爽点类型：【装逼/收获/打脸/震惊/其他】\n自检结论：【通过/需优化】\n问题与优化：列出发现的问题"
  }
}
