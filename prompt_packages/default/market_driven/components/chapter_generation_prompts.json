{
  "version": "2.0.0",
  "description": "市场化导向章节生成提示词配置 - 支持JSON格式输出",
  
  "output_format": {
    "type": "json",
    "schema": {
      "title": "string (8-14字，不含'第X章'前缀)",
      "content": "string (2000-2500字，正文开头不要写标题)"
    },
    "rules": [
      "title字段只放标题文本，不要加'第X章'前缀",
      "content字段只放正文，绝对禁止在正文开头写'第X章 XXX'这样的标题行",
      "系统会自动将title和content组合展示"
    ]
  },
  
  "chapter_prompts": {
