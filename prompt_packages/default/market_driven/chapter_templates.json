  "common_requirements": {
    "all_chapters": [
      "字数：2200-2500字",
      "前300字必须有冲突/悬念",
      "每1000字必须有一个小爽点",
      "章尾最后50字必须是钩子",
      "对话占比≥50%",
      "每段不超过3行"
    ],
    "format": {
      "no_chapter_title": "不要写'第X章'标题，直接从场景开始",
      "no_layer_labels": "不要写'第一层/第二层'标签，用自然叙事",
      "separator": "必须包含 '---正文结束---' 分隔符",
      "self_check": "必须包含AI自检报告"
    }
  },
  
  "golden_three": {
    "chapter_1": {
      "type": "SETUP + HOOK",
      "special_requirements": [
        "极端困境开局（500字）",
        "系统觉醒（1500字）",
        "悬念钩子（300字）"
      ]
    },
    "chapter_2": {
      "type": "REWARD + SETUP",
      "special_requirements": [
        "系统功能展示（800字）",
        "小规模收益（1200字）",
        "新冲突铺垫（300字）"
      ]
    },
    "chapter_3": {
      "type": "FACE_SLAP",
      "special_requirements": [
        "第一次正式打脸",
