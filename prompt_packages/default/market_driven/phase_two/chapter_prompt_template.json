{
  "version": "1.0.0",
  "description": "阶段式章节生成器的单章提示词模板",
  "template_parts": {
    "header": "请生成第{{chapter_num}}章（第{{stage_number}}周期 第{{relative_ch}}章）。",
    "chapter_positioning": [
      "",
      "## 本章定位",
      "- 所在周期：{{stage_name}}",
      "- 章节类型：{{chapter_type}}",
      "- 情绪要求：{{emotion}}"
    ],
    "rhythm_info": "- 节奏节点：{{rhythm}}",
    "event_info": "- 核心事件：{{event}}",
    "climax_indicators": {
      "final_climax": [
        "",
        "🔥 **【周期高潮】本章必须达到：{{climax_type}}**",
        "🔥 **这是本周期的终极高潮，必须爽到极致！**",
        ""
      ],
      "countdown_5": [
        "",
        "⚠️ **距离周期高潮还有5章，开始密集铺垫！**",
        ""
      ],
      "countdown_10": [
        "",
        "📈 **进入冲刺阶段，为周期高潮做最后准备！**",
        ""
      ],
      "small_climax": [
        "",
        "💥 **【3章节点】本章是小高潮，必须有打脸/收获爽点！**",
        ""
      ],
      "medium_climax": [
        "",
        "💥💥 **【10章节点】本章是中高潮，必须有重大收获/身份升级！**",
        ""
      ],
      "large_climax": [
        "",
        "💥💥💥 **【20章节点】本章是大高潮，必须有重大转折/实力飞跃！**",
        ""
      ]
    },
    "previous_summary": [
      "",
      "## 前文摘要（必须承接）",
      "{{prev_summary}}",
      ""
    ],
    "writing_requirements": [
      "",
      "## 写作要求",
      "1. 字数2000-2500字",
      "2. 情绪严格遵循：{{emotion}}",
      "3. 承接上文，推动剧情",
      "4. 结尾留钩子",
      "",
      "直接输出章节正文。"
    ]
  },
  "variables": [
    "chapter_num",
    "stage_number",
    "relative_ch",
    "stage_name",
    "chapter_type",
    "emotion",
    "rhythm",
    "event",
    "climax_type",
    "chapters_to_climax",
    "prev_summary"
  ],
  "defaults": {
    "chapter_type": "推进",
    "emotion": "期待",
    "rhythm": "",
    "event": "",
    "prev_summary": ""
  },
  "climax_rules": {
    "final_climax_condition": "chapter_num == climax_ch",
    "countdown_5_condition": "chapters_to_climax == 5",
    "countdown_10_condition": "chapters_to_climax == 10",
    "small_climax_condition": "chapter_type == '小高潮'",
    "medium_climax_condition": "chapter_type == '中高潮'",
    "large_climax_condition": "chapter_type == '大高潮'"
  },
  "metadata": {
    "author": "system",
    "created_at": "2026-03-31",
    "purpose": "stage_chapter_generator chapter prompt",
    "backward_compatible": true
  }
}
