{
  "style_id": "crisis",
  "style_name": "危机流写法",
  "version": "1.0.0",
  "description": "生死存亡，绝处逢生，让读者紧张到极点后的释放",
  
  "core_principles": [
    "危机前兆：细微的异常铺垫，让读者预感不妙",
    "危机爆发：突然的灾难降临，让读者措手不及",
    "绝望时刻：主角濒死/绝境，让读者感同身受",
    "金手指救命：系统/突破/救援，绝处逢生",
    "绝地反击：逆袭成功，让读者痛快释放"
  ],
  
  "structure": {
    "name": "危机章结构",
    "total_words": "2400-2500字",
    "phases": [
      {
        "name": "平静",
        "word_count": "0-500字",
        "intensity": 5,
        "description": "危机前兆",
        "requirements": ["日常场景", "细微异常", "读者预感不妙"]
      },
      {
        "name": "爆发",
        "word_count": "501-1000字",
        "intensity": 9,
        "description": "危机降临",
        "requirements": ["危机突然爆发", "主角措手不及", "形势急剧恶化"]
      },
      {
        "name": "绝望",
        "word_count": "1001-1500字",
        "intensity": 10,
        "description": "生死存亡",
        "requirements": ["主角濒死/绝境", "希望渺茫", "读者紧张到极点"]
      },
      {
        "name": "转机",
        "word_count": "1501-2000字",
        "intensity": 8,
        "description": "金手指救命",
        "requirements": ["系统救命", "绝境突破", "新能力/手段出现"]
      },
      {
        "name": "反击",
        "word_count": "2001-2400字",
        "intensity": 9,
        "description": "绝地反击",
        "requirements": ["逆袭开始", "局势逆转", "敌人溃败"]
      },
      {
        "name": "钩子",
        "word_count": "2401-2500字",
        "intensity": 7,
        "description": "新危机",
        "requirements": ["更大危机预告", "新目标确立", "强烈期待感"]
      }
    ]
  },
  
  "crisis_types": {
    "physical": {
      "name": "物理危机",
      "description": "追杀/陷阱/天灾",
      "examples": ["被强敌追杀", "落入陷阱", "遭遇天灾"]
    },
    "identity": {
      "name": "身份危机",
      "description": "身份暴露/被识破",
      "examples": ["假身份被揭穿", "秘密被发现", "卧底身份暴露"]
    },
    "system": {
      "name": "系统危机",
      "description": "系统故障/被封印",
      "examples": ["系统宕机", "能力被封印", "金手指失效"]
    },
    "interpersonal": {
      "name": "人际危机",
      "description": "背叛/误解/孤立",
      "examples": ["挚友背叛", "被众人误解", "陷入孤立无援"]
    }
  },
  
  "rescue_methods": {
    "system": {
      "name": "系统救命",
      "examples": ["紧急任务奖励", "隐藏功能解锁", "系统升级"]
    },
    "breakthrough": {
      "name": "绝境突破",
      "examples": ["生死关头突破境界", "领悟新技能", "觉醒隐藏能力"]
    },
    "rescue": {
      "name": "外部救援",
      "examples": ["神秘人出手", "盟友赶到", "天降奇兵"]
    },
    "wit": {
      "name": "智谋脱险",
      "examples": ["利用环境反杀", "智取敌人", "金蝉脱壳"]
    }
  },
  
  "required_elements": [
    "危机前兆：细微的异常",
    "危机爆发：突然的灾难",
    "绝望时刻：主角濒死/绝境",
    "金手指：系统救命/突破",
    "绝地反击：逆袭成功"
  ],
  
  "emotion_curve": {
    "description": "情绪曲线：平静→爆发→绝望→转机→反击→期待",
    "intensities": [5, 9, 10, 8, 9, 7],
    "goal": "让读者经历从放松→紧张→绝望→希望→痛快→期待的情绪过山车"
  },
  
  "forbidden": [
    "危机太弱（必须有生死感）",
    "解决太简单（必须有波折）",
    "没有后遗症（危机后要有影响）",
    "绝望不够深（必须让读者绝望）",
    "救援太突兀（必须有铺垫）"
  ],
  
  "checklist": [
    "危机前兆是否细微但明显？",
    "危机爆发是否突然？",
    "绝望时刻是否让读者绝望？",
    "金手指救命是否合理？",
    "绝地反击是否痛快？",
    "危机后是否有后遗症？"
  ]
}
