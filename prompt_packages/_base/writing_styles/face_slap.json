{
  "style_id": "face_slap",
  "style_name": "打脸流写法",
  "version": "1.0.0",
  "description": "爽点爆发，当众打脸，让读者感到痛快和解气",
  
  "core_principles": [
    "先抑后扬：反派先极致嚣张，主角后强势碾压",
    "公开场合：必须有围观群众，打脸要当众",
    "具体数字：展示精确的金额/数值，增强真实感",
    "多层震惊：现场→传播→权威，用自然叙事不要贴标签",
    "态度转变：反派从嚣张到恐惧/跪舔的180度转变"
  ],
  
  "structure": {
    "name": "打脸章结构",
    "total_words": "2300-2500字",
    "phases": [
      {
        "name": "压抑",
        "word_count": "0-300字",
        "intensity": 8,
        "description": "反派极致羞辱",
        "requirements": ["反派语言恶毒", "动作羞辱", "周围人嘲笑"]
      },
      {
        "name": "转折",
        "word_count": "301-800字",
        "intensity": 7,
        "description": "主角反击开始",
        "requirements": ["主角亮出底牌", "反派开始怀疑", "围观者震惊"]
      },
      {
        "name": "爆发",
        "word_count": "801-1800字",
        "intensity": 10,
        "description": "碾压式打脸",
        "requirements": ["主角完全碾压", "反派崩溃", "具体数字展示"]
      },
      {
        "name": "满足",
        "word_count": "1801-2300字",
        "intensity": 9,
        "description": "收获展示",
        "requirements": ["系统提示", "具体收益", "反派态度转变"]
      },
      {
        "name": "钩子",
        "word_count": "2301-2500字",
        "intensity": 7,
        "description": "新危机/机遇",
        "requirements": ["更大反派出现", "新目标确立", "强烈期待感"]
      }
    ]
  },
  
  "required_elements": [
    "公开场合（有围观群众）",
    "反派极致羞辱（先抑）",
    "主角强势反击（后扬）",
    "具体数字（金额/数值）",
    "多层震惊（现场→传播→权威）",
    "反派态度180度转变"
  ],
  
  "beat_progression": {
    "description": "打脸节奏递进",
    "steps": [
      { "step": 1, "name": "开局压制", "content": "反派嘲讽：\"就凭你？\"" },
      { "step": 2, "name": "初步反击", "content": "主角反击：展示小部分实力" },
      { "step": 3, "name": "冲突升级", "content": "反派加码：叫更多人/搬出后台" },
      { "step": 4, "name": "高潮碾压", "content": "主角碾压：彻底碾压，全场震惊" }
    ]
  },
  
  "shock_flow": {
    "description": "震惊流要求",
    "warning": "不要写'第X层'标签！用自然叙事展现",
    "levels": [
      "先写现场围观者反应（表情/语言/动作）",
      "再写直播/传播扩散（弹幕/朋友圈/热搜）",
      "最后写权威反应（专家/领导/官方）"
    ]
  },
  
  "examples": {
    "oppression_lines": [
      "就凭你这个废物也配？",
      "给我跪下舔干净！",
      "你知道我是谁吗？"
    ],
    "comeback_lines": [
      "现在，该我了。",
      "你刚才说什么？我没听清。",
      "这就是你说的实力？"
    ],
    "villain_defeat_lines": [
      "不...不可能！",
      "你...你到底是谁？",
      "饶命！我有眼不识泰山！"
    ]
  },
  
  "forbidden": [
    "没有具体数字的虚写",
    "反派降智（毫无理由的嚣张）",
    "圣母心（该杀不杀）",
    "私下打脸（必须有观众）",
    "反派态度转变生硬（需要过程）"
  ],
  
  "checklist": [
    "反派羞辱是否让读者恨？",
    "主角反击是否痛快？",
    "是否有具体数字？",
    "多层震惊是否自然（无标签）？",
    "反派态度是否有180度转变？",
    "章尾是否有新钩子？"
  ]
}
