{
  "style_id": "setup",
  "style_name": "铺垫流写法",
  "version": "1.0.0",
  "description": "积蓄情绪，为下一章的爽点做准备，让读者产生强烈期待",
  
  "core_principles": [
    "先抑后扬的前半段：本章只抑不扬，把压抑做到极致",
    "让读者恨反派：反派要嚣张到让读者想钻进屏幕打人",
    "让读者心疼主角：主角要隐忍到让读者心疼",
    "建立期待感：明确铺垫下一章的反击/打脸",
    "章尾必须有钩子：让读者必须点下一章"
  ],
  
  "structure": {
    "name": "铺垫章结构",
    "total_words": "2400-2500字",
    "phases": [
      {
        "name": "平静",
        "word_count": "0-500字",
        "intensity": 5,
        "description": "日常铺垫",
        "requirements": ["展示主角现状", "埋下危机伏笔", "正常生活节奏"]
      },
      {
        "name": "压抑",
        "word_count": "501-1200字",
        "intensity": 7,
        "description": "反派嚣张",
        "requirements": ["反派登场", "极致羞辱", "主角无力反抗"]
      },
      {
        "name": "愤怒",
        "word_count": "1201-2000字",
        "intensity": 8,
        "description": "主角被欺",
        "requirements": ["主角内心愤怒", "但仍需隐忍", "读者情绪被点燃"]
      },
      {
        "name": "期待",
        "word_count": "2001-2400字",
        "intensity": 7,
        "description": "准备反击",
        "requirements": ["主角开始准备", "获得反击手段/信息", "读者期待反击"]
      },
      {
        "name": "钩子",
        "word_count": "2401-2500字",
        "intensity": 6,
        "description": "悬念",
        "requirements": ["明确下一章行动", "时间锁/信息差", "强烈期待感"]
      }
    ]
  },
  
  "required_elements": [
    "反派的极致嚣张（让读者恨）",
    "主角的隐忍（让读者心疼）",
    "准备反击的铺垫（让读者期待）",
    "章尾钩子（必须点下一章）"
  ],
  
  "emotion_goals": {
    "reader": ["同情主角", "憎恨反派", "期待反击"],
    "protagonist": ["愤怒", "隐忍", "暗中准备"],
    "villain": ["嚣张", "得意", "轻视主角"]
  },
  
  "hook_types": [
    {
      "type": "时间锁",
      "example": "3天后就是婚礼/考试/决斗，主角只有72小时"
    },
    {
      "type": "信息差",
      "example": "主角知道了反派不知道的秘密"
    },
    {
      "type": "新能力",
      "example": "主角刚刚获得新能力，准备测试"
    },
    {
      "type": "危机预警",
      "example": "更大的危机即将到来"
    }
  ],
  
  "forbidden": [
    "本章出现爽点（要憋到下一章）",
    "主角过早反击（必须在下一章）",
    "平淡的日常（必须有冲突）",
    "反派不够可恨（要让读者想打人）",
    "没有明确期待（读者不知道在等什么）"
  ],
  
  "checklist": [
    "反派是否让读者恨得牙痒痒？",
    "主角是否让读者心疼？",
    "是否为下一章反击做了充分铺垫？",
    "章尾钩子是否让读者必须点下一章？",
    "本章是否完全没有爽点（憋着）？"
  ]
}
